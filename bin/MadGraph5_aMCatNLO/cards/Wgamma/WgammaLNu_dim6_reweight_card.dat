change helicity False
change rwgt_dir rwgt

# SM rwgt_1
launch --rwgt_name=SM
   set SMEFT 5 0
   set SMEFT 28 0
   set SMEFT 104 0
   set SMEFT 9 0
   set SMEFT 109 0
   set SMEFT 2 0


