#*                                                          *
#*     run as ./bin/mg5_aMC  filename                       *
#*                                                          *
#************************************************************
set default_unset_couplings 99
set ignore_six_quark_processes False
set loop_optimized_output True
set loop_color_flows False
set gauge unitary
set complex_mass_scheme False
set max_npoint_for_channel 0
define p  =  g u c d s u~ c~ d~ s~
set mg5_path /data9/Users/shjeon/MadGraph_Contact/forVV/genproductions\
/bin/MadGraph5_aMCatNLO/WWToLNuQQ_4f_amcatnloFxFx/WWToLNuQQ_4f_amcatnl\
oFxFx_gridpack/work/MG5_aMC_v2_6_5
set group_subprocesses False
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
generate p p > ell+ vl w- , w- > j j  QCD=99, w+ > j j  QCD=99 @0 --no\
_warning=duplicate
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
add process p p > ell+ vl w- pert_QCD , w- > j j  QCD=99, w+ > j j  QC\
D=99 @0 --no_warning=duplicate
add process p p > ell+ vl w- j , w- > j j  QCD=99, w+ > j j  QCD=99 @1\
 --no_warning=duplicate
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
add process p p > ell+ vl w- j pert_QCD , w- > j j  QCD=99, w+ > j j  \
QCD=99 @1 --no_warning=duplicate
add process p p > ell- vl~ w+ , w- > j j  QCD=99, w+ > j j  QCD=99 @2 \
--no_warning=duplicate
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
add process p p > ell- vl~ w+ pert_QCD , w- > j j  QCD=99, w+ > j j  Q\
CD=99 @2 --no_warning=duplicate
add process p p > ell- vl~ w+ j , w- > j j  QCD=99, w+ > j j  QCD=99 @\
3 --no_warning=duplicate
define pert_QCD = -4 -3 -2 -1 1 2 3 4 21
add process p p > ell- vl~ w+ j pert_QCD , w- > j j  QCD=99, w+ > j j \
 QCD=99 @3 --no_warning=duplicate
output standalone_msF /data9/Users/shjeon/MadGraph_Contact/forVV/genpr\
oductions/bin/MadGraph5_aMCatNLO/WWToLNuQQ_4f_amcatnloFxFx/WWToLNuQQ_4\
f_amcatnloFxFx_gridpack/work/processtmp/madspingrid/full_me w- w+
