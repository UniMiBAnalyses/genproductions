set group_subprocesses Auto
set ignore_six_quark_processes False
set loop_optimized_output True
set complex_mass_scheme False
import model SMEFTsim_topU3l_MwScheme_UFO_b_massless-cW_cHWB_cHbox_cHW_cHl1_cHB_cHQ1_cHj1_massless
define p = g u c d s b u~ c~ d~ s~ b~
define j = p 
define l+ = e+ mu+ ta+
define l- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate p p > w- z j j NP=1 QCD=0 SMHLOOP=0 
output WMlepZhadJJ_EWK_LO_SM_mjj100_pTj10_dim6 --nojpeg
