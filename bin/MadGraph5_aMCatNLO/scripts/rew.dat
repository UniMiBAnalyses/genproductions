change helicity False
change rwgt_dir rwgt

change mode NLO

# SM rwgt_1
launch --rwgt_name=sm
   set DIM64F2L 2 0
   set DIM64F2L 4 0
   set DIM64F2L 6 0
   set DIM64F4L 7 0
   set DIM6 2 0
   set DIM6 3 0
   set DIM62F 2 0
   set DIM62F 4 0
   set DIM62F 5 0
   set DIM62F 8 0
   set DIM62F 10 0
   set DIM62F 11 0
   set DIM62F 12 0
   set DIM62F 13 0
   set DIM62F 14 0
   set DIM62F 16 0


